from os import PathLike
from types import TracebackType
from enum import IntEnum
from typing import Any, Iterable, Sequence, TypeVar

__version__: str
Color = tuple[int, int, int] | tuple[int, int, int, int]
_Vec2 = tuple[float, float]
_Vec3 = tuple[float, float, float]
_T = TypeVar("_T", bound="_Resource")
_C = TypeVar("_C", bound="_Canvas")

class Error(RuntimeError): ...
class StateError(Error): ...
class BusyError(Error): ...
class UnsupportedError(Error): ...
class DrawMode(IntEnum):
    WIRE = 0
    FILLED = 1
class PanelOrder(IntEnum):
    RGB = 0
    RBG = 1
    GRB = 2
    GBR = 3
    BRG = 4
    BGR = 5
class Mapping(IntEnum):
    NONE = 0
    FLIP = 1
    MIRROR = 2
    MIRROR_FLIP = 3
    U = 4
class OutputMode(IntEnum):
    EQUAL_SLOT = 0
    WEIGHTED_BCM = 1

class ColorCurve(IntEnum):
    CIE = 0
    GAMMA = 1

class ToneMapping(IntEnum):
    NONE = 0
    ACES = 1
    REINHARD = 2
    HABLE = 3
    SATURATION = 4
    SIGMOID = 5
class GradientDirection(IntEnum):
    HORIZONTAL = 0
    VERTICAL = 1
    DIAGONAL = 2
    RADIAL = 3
class Easing(IntEnum):
    LINEAR = 0
    IN_QUAD = 1
    OUT_QUAD = 2
    IN_OUT_QUAD = 3
class DisplayState(IntEnum):
    CREATED = 0
    RUNNING = 1
    STOPPING = 2
    STOPPED = 3
    CLOSED = 4

from dataclasses import dataclass
@dataclass(frozen=True)
class DisplayConfig:
    width: int = ...
    height: int = ...
    panel_width: int = ...
    panel_height: int = ...
    ports: int = ...
    chains: int = ...
    bit_depth: int = ...
    output_mode: OutputMode = ...
    pwm_bits: int = ...
    pwm_lsb_ns: int = ...
    color_curve: ColorCurve = ...
    fps: int = ...
    brightness: int = ...
    queue_depth: int = ...
    panel_order: PanelOrder = ...
    mapping: Mapping = ...
    tone_mapping: ToneMapping = ...
    gamma: float = ...
    dither: float = ...
    tone_level: float = ...
    offscreen: bool = ...
    quant_dither: bool = ...
    jitter: bool = ...
    gpio_cpu: int = ...

def capabilities() -> dict[str, Any]: ...

class _Resource:
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def __enter__(self: _T) -> _T: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> None: ...
class Image(_Resource):
    def __init__(self, width: int, height: int, data: Any = ..., *, format: str = ...,
                 row_stride: int | None = ...) -> None: ...
    @classmethod
    def load(cls, path: PathLike[str] | str) -> Image: ...
    @property
    def dimensions(self) -> tuple[int, int]: ...
    def upload(self, data: Any, *, format: str = ..., row_stride: int | None = ...) -> Image: ...
    def tobytes(self) -> bytes: ...
    def memoryview(self) -> memoryview: ...
    def transformed(self, mapping: Mapping) -> Image: ...
    def numpy(self) -> Any: ...
    def pillow(self) -> Any: ...
class Transform(_Resource):
    position: _Vec3
    rotation: _Vec3
    scale: _Vec3
    def __init__(self, *, position: Sequence[float] = ..., rotation: Sequence[float] = ...,
                 scale: Sequence[float] = ...) -> None: ...
class Camera(_Resource):
    position: _Vec3
    target: _Vec3
    up: _Vec3
    fov_y: float
    aspect: float
    z_near: float
    z_far: float
    def __init__(self, *, position: Sequence[float] = ..., target: Sequence[float] = ...,
                 up: Sequence[float] = ..., fov_y: float = ..., aspect: float = ...,
                 z_near: float = ..., z_far: float = ...) -> None: ...
    def project(self, transform: Transform) -> tuple[float, ...]: ...
class Mesh(_Resource):
    draw_mode: DrawMode
    cull_backface: bool
    shadow_enabled: bool
    specular_strength: float
    specular_shininess: float
    def __init__(self, vertices: Any, *, edges: Any = ..., faces: Any = ...) -> None: ...
    @classmethod
    def primitive(cls, name: str, *, segments: int = ..., minor_segments: int = ...,
                  subdivisions: int = ..., width_segments: int = ..., height_segments: int = ...,
                  mode: DrawMode = ..., cull_backface: bool = ...) -> Mesh: ...
    @classmethod
    def cube(cls, **kwargs: Any) -> Mesh: ...
    def set_color(self, color: tuple[int, int, int]) -> None: ...
@dataclass(frozen=True)
class Instance:
    scene: Scene3D
    id: int
    mesh: Mesh
    transform: Transform
class Light:
    scene: Scene3D
    id: int
    def __init__(self, scene: Scene3D, index: int) -> None: ...
    def set(self, *, direction: Sequence[float] | None = ..., color: Sequence[float] | None = ...,
            intensity: float | None = ..., shadow_enabled: bool | None = ...,
            shadow_zoom: float | None = ...) -> None: ...
class Scene3D(_Resource):
    ambient: _Vec3
    def __init__(self, *, ambient: Sequence[float] = ...) -> None: ...
    def add(self, mesh: Mesh, transform: Transform | None = ..., *,
            angular_velocity: Sequence[float] = ...) -> Instance: ...
    def set_transforms(self, values: Any) -> None: ...
    def directional_light(self, direction: Sequence[float] = ..., *, color: Sequence[float] = ...,
                          intensity: float = ..., shadows: bool = ...) -> Light: ...
class Font(_Resource):
    def __init__(self, directory: PathLike[str] | str, *, size: float = ...) -> None: ...
class Text(_Resource):
    position: _Vec2
    direction: _Vec2
    speed: float
    size: float
    tracking: float
    angle: float
    wrap: bool
    kerning: bool
    sine: _Vec3
    weight: float
    outline_width: float
    color: Color
    outline_color: Color
    def __init__(self, font: Font, text: str, *, position: Sequence[float] = ...,
                 color: Color = ..., speed: float = ..., direction: Sequence[float] = ...) -> None: ...
    def set_text(self, text: str) -> None: ...
    @property
    def dimensions(self) -> tuple[int, int]: ...

class _Canvas:
    def clear(self: _C, color: Color = ...) -> _C: ...
    def pixel(self: _C, x: int, y: int, color: Color) -> _C: ...
    def line(self: _C, x0: int, y0: int, x1: int, y1: int, color: Color, *, antialias: bool = ...) -> _C: ...
    def polygon(self: _C, points: Sequence[Sequence[float]], color: Color) -> _C: ...
    def gradient(self: _C, points: Sequence[Sequence[float]], start: tuple[int, int, int],
                 end: tuple[int, int, int], *, direction: GradientDirection = ...,
                 easing: Easing = ...) -> _C: ...
    def blit(self: _C, source: Any, *, x: float = ..., y: float = ..., width: int | None = ...,
             height: int | None = ..., scale: float = ..., format: str = ...,
             row_stride: int | None = ...) -> _C: ...
    def render(self: _C, scene: Scene3D, camera: Camera) -> _C: ...
    def text(self: _C, text: Text) -> _C: ...
class DrawList(_Resource, _Canvas):
    def __init__(self) -> None: ...
    def reset(self) -> DrawList: ...
    def lines_buffer(self, xyxy: Any, color: Color, *, antialias: bool = ..., replace: bool = ...) -> DrawList: ...
    def points_buffer(self, xy: Any, color: Color, *, replace: bool = ...) -> DrawList: ...
    def lines(self, lines: Iterable[Sequence[int]], color: Color, *, antialias: bool = ...) -> DrawList: ...
    def points(self, points: Iterable[Sequence[int]], color: Color) -> DrawList: ...
class Frame(_Canvas):
    display: Display
    timeout: float | None
    def __init__(self, display: Display, timeout: float | None) -> None: ...
    def __enter__(self) -> Frame: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> None: ...
    def upload(self, data: Any, *, format: str = ..., row_stride: int | None = ...) -> Frame: ...
    def draw(self, draw_list: DrawList, *, time: float = ...) -> Frame: ...
    def submit(self) -> None: ...
    def cancel(self) -> None: ...
class Playback:
    display: Display
    def __init__(self, display: Display, generation: int) -> None: ...
    @property
    def playing(self) -> bool: ...
    @property
    def error(self) -> Exception | None: ...
    def ready(self, timeout: float | None = ...) -> None: ...
    def pause(self) -> None: ...
    def resume(self) -> None: ...
    def wait(self, timeout: float | None = ...) -> None: ...
    def stop(self, timeout: float | None = ...) -> None: ...
    def __enter__(self) -> Playback: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> None: ...
class Display:
    @property
    def error(self) -> Exception | None: ...
    @property
    def config(self) -> DisplayConfig: ...
    def __init__(self, config: DisplayConfig | None = ...) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def state(self) -> DisplayState: ...
    def start(self) -> Display: ...
    def __enter__(self) -> Display: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                 tb: TracebackType | None) -> None: ...
    def close(self, timeout: float | None = ...) -> None: ...
    def request_stop(self) -> None: ...
    def wait(self, timeout: float | None = ...) -> None: ...
    def frame(self, timeout: float | None = ...) -> Frame: ...
    def try_submit(self, draw_list: DrawList, *, time: float = ...) -> bool: ...
    def flush(self, timeout: float | None = ...) -> None: ...
    def snapshot(self, *, timeout: float | None = ...) -> bytes: ...
    def stats(self) -> dict[str, Any]: ...
    def play(self, draw_list: DrawList) -> Playback: ...
    def play_shader(self, path: PathLike[str] | str, *, time_scale: float = ...,
                    overlay: DrawList | None = ...) -> Playback: ...
    def play_video(self, path: PathLike[str] | str, *, loop: bool = ..., time_scale: float = ...,
                   overlay: DrawList | None = ...) -> Playback: ...
